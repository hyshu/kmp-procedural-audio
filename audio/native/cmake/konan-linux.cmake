set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(PCM_AUDIO_LLVM_ROOT "$ENV{PCM_AUDIO_LLVM_ROOT}" CACHE PATH "Kotlin Native LLVM directory")
set(PCM_AUDIO_LINUX_ROOT "$ENV{PCM_AUDIO_LINUX_ROOT}" CACHE PATH "Kotlin Native Linux toolchain directory")
if(NOT PCM_AUDIO_LLVM_ROOT OR NOT PCM_AUDIO_LINUX_ROOT)
    message(FATAL_ERROR "Set PCM_AUDIO_LLVM_ROOT and PCM_AUDIO_LINUX_ROOT to the Kotlin Native dependency directories")
endif()
file(TO_CMAKE_PATH "${PCM_AUDIO_LLVM_ROOT}" PCM_AUDIO_LLVM_ROOT)
file(TO_CMAKE_PATH "${PCM_AUDIO_LINUX_ROOT}" PCM_AUDIO_LINUX_ROOT)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PCM_AUDIO_LLVM_ROOT PCM_AUDIO_LINUX_ROOT)
if(CMAKE_HOST_WIN32)
    set(PCM_AUDIO_TOOL_SUFFIX ".exe")
else()
    set(PCM_AUDIO_TOOL_SUFFIX "")
endif()

set(CMAKE_CXX_COMPILER "${PCM_AUDIO_LLVM_ROOT}/bin/clang++${PCM_AUDIO_TOOL_SUFFIX}")
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-linux-gnu)
set(CMAKE_SYSROOT "${PCM_AUDIO_LINUX_ROOT}/x86_64-unknown-linux-gnu/sysroot")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=\"${PCM_AUDIO_LINUX_ROOT}\"")
set(CMAKE_AR "${PCM_AUDIO_LLVM_ROOT}/bin/llvm-ar${PCM_AUDIO_TOOL_SUFFIX}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${CMAKE_AR}" CACHE FILEPATH "" FORCE)
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/archive-rules.cmake")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
